# Copy to .env. Leave blank to use skills, saved notes, and runtime APIs without Azure.
# Existing Microsoft Foundry project; NOT a classic hub connection string or an OpenAI endpoint.
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL_DEPLOYMENT=

# Prompt agents are created lazily in your existing project and their versions are reused.
FOUNDRY_AGENT_PREFIX=enterprise-memory-demo

# DefaultAzureCredential runs on the server. For local use: az login
# Alternatively configure an approved managed identity or service principal outside source control.
# Never put credentials in VITE_* variables.

# Optional. Defaults to data/enterprise-memory.sqlite3 relative to this repository.
# MEMORY_DB_PATH=
